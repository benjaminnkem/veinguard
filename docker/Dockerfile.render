# Render's Free tier does not provide a free background-worker instance.
# This image keeps the service boundaries intact while running the API,
# BullMQ worker, Python simulation, Next.js web app, and a small HTTP gateway
# under one Render Web Service.

FROM node:22-bookworm-slim AS builder

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_BASE_URL=/api/v1 \
    NEXT_PUBLIC_APP_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      gfortran \
      libopenblas-dev \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /workspace
COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm build

RUN python3 -m venv /opt/veinguard-venv \
    && /opt/veinguard-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/veinguard-venv/bin/pip install --no-cache-dir ./services/simulation


FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/veinguard-venv/bin:$PATH \
    VEINGUARD_WORKSPACE=/workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgomp1 \
      libopenblas0 \
      python3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin veinguard

WORKDIR /workspace
COPY --from=builder /opt/veinguard-venv /opt/veinguard-venv
COPY --from=builder --chown=veinguard:veinguard /workspace /workspace

USER veinguard

EXPOSE 10000

CMD ["node", "docker/render/supervisor.mjs"]
