{
  "name": "veinguard",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=api --filter=worker",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev:worker": "turbo run dev --filter=worker",
    "dev:simulation": "bash scripts/dev-simulation.sh",
    "dev:infra": "docker compose up -d --wait",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "setup:env": "bash scripts/bootstrap-env.sh",
    "setup:simulation": "bash scripts/setup-simulation.sh",
    "seed:demo": "pnpm --filter api seed:demo",
    "bootstrap": "bash scripts/bootstrap-env.sh && docker compose up -d --wait && pnpm install && bash scripts/setup-simulation.sh"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
